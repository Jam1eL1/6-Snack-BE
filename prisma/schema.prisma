generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  name               String
  password           String
  companyId          Int
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  hashedRefreshToken String?

  role                  Role
  cartItems             CartItem[]
  favorites             Favorite[]
  company               Company    @relation(fields: [companyId], references: [id])
  orders                Order[]    @relation("UserOrders")
  invites               Invite[]   @relation("InvitedBy")
  products              Product[]  @relation("ProductCreator")
  paymentAssignedOrders Order[]    @relation("OrderPaymentAssignee")
  authorizedPayments    Payment[]  @relation("AuthorizedPaymentPayer")
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  bizNumber String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budgets MonthlyBudget[]
  users   User[]
  invites Invite[]
  Order   Order[]
}

// Monthly expense & budget
model MonthlyBudget {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  currentMonthExpense Int       @default(0) // Current-month expense in CAD cents
  currentMonthBudget  Int       @default(0) // Current-month budget in CAD cents
  monthlyBudget       Int       @default(0) // Default monthly budget in CAD cents
  year                String
  month               String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
  company             Company   @relation(fields: [companyId], references: [id])

  @@unique([companyId, year, month])
}

model Product {
  id              Int       @id @default(autoincrement())
  categoryId      Int
  creatorId       String
  name            String
  price           Int // CAD cents
  imageUrl        String
  linkUrl         String
  cumulativeSales Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  cart      CartItem[]
  favorites Favorite[]
  receipts  Receipt[]
  creator   User       @relation("ProductCreator", fields: [creatorId], references: [id])
  category  Category   @relation(fields: [categoryId], references: [id])
}

model Category {
  id       Int    @id @default(autoincrement())
  name     String
  parentId Int?

  products Product[]
  children Category[] @relation("CategoryToCategory_children")
  parent   Category?  @relation("CategoryToCategory_children", fields: [parentId], references: [id])
}

model CartItem {
  id        Int       @id @default(autoincrement())
  userId    String
  productId Int
  quantity  Int
  isChecked Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model Receipt {
  id          Int      @id @default(autoincrement())
  productId   Int
  orderId     String
  productName String
  price       Int // CAD cents captured when the Order is created
  imageUrl    String
  quantity    Int
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])
}

model Order {
  id                    String      @id @default(uuid())
  companyId             Int
  userId                String
  approver              String?
  adminMessage          String?
  requestMessage        String?
  deliveryFee           Int // CAD cents
  productsPriceTotal    Int // CAD cents
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  status                OrderStatus
  paymentAssigneeId     String?
  paymentClaimExpiresAt DateTime?
  paymentAssignee       User?       @relation("OrderPaymentAssignee", fields: [paymentAssigneeId], references: [id], onDelete: SetNull)

  receipts Receipt[]
  payment  Payment?
  user     User      @relation("UserOrders", fields: [userId], references: [id])
  company  Company   @relation(fields: [companyId], references: [id])

  @@index([paymentAssigneeId])
}

model Payment {
  id                Int           @id @default(autoincrement())
  orderId           String        @unique
  authorizedPayerId String
  amount            Int // CAD cents
  method            PaymentMethod @default(DUMMY)
  status            PaymentStatus @default(PENDING)
  failureReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  completedAt       DateTime?

  order           Order @relation(fields: [orderId], references: [id])
  authorizedPayer User  @relation("AuthorizedPaymentPayer", fields: [authorizedPayerId], references: [id])

  @@index([authorizedPayerId])
}

model Invite {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String
  companyId   Int
  invitedById String
  expiresAt   DateTime
  isUsed      Boolean  @default(false)

  role      Role
  company   Company @relation(fields: [companyId], references: [id])
  invitedBy User    @relation("InvitedBy", fields: [invitedById], references: [id])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    String
  productId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
  INSTANT_APPROVED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  DUMMY
}
