@adminABaseUrl=http://localhost:8080
@adminBBaseUrl=http://127.0.0.1:8080
@orderId=REPLACE_WITH_PENDING_ORDER_ID

# Run both requests in 00-payment-auth.http first.
#
# Initial database state:
# Order.status = PENDING
# Order.paymentAssigneeId = null
# Order.paymentClaimExpiresAt = null
# Order.payment = null

### Admin A — Start Payment
# Expected: 200
# Response contains orderId and paymentId.
# Order remains PENDING.
POST {{adminABaseUrl}}/admin/orders/{{orderId}}/payment

### Admin A — Start the Same Payment Again
# Send after Admin A starts Payment.
# Expected: 200
# Returns the same paymentId without extending the claim.
POST {{adminABaseUrl}}/admin/orders/{{orderId}}/payment

### Admin B — Start While Admin A Owns the Active Claim
# Expected: 409
POST {{adminBBaseUrl}}/admin/orders/{{orderId}}/payment

### Admin B — Reclaim an Expired Payment
# Before sending, use Prisma Studio to set:
# Order.paymentClaimExpiresAt = a time in the past
#
# Expected: 200
# Returns the same paymentId.
# Order.paymentAssigneeId = user-2
# Payment.authorizedPayerId = user-2
POST {{adminBBaseUrl}}/admin/orders/{{orderId}}/payment

### Admin A — Start Payment for Missing Order
# Expected: 404
POST {{adminABaseUrl}}/admin/orders/missing-order/payment
